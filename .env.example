# ──────────────────────────────────────────────────────────────────────────
# Yenetta environment configuration. Copy to `.env` and fill in real values.
# NEVER commit a real .env — only this example file is tracked.
# ──────────────────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
SITE_URL=https://www.yenetta.com
NEXT_PUBLIC_SITE_URL=https://www.yenetta.com
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Security: comma-separated CORS allowlist (never "*") and max request body size.
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1mb
# Phone number promoted to the admin role by the seed (admin RBAC).
ADMIN_PHONE=
WEB_PORT=3000
API_PORT=3001

# Database (keep personal-data DB separable for in-country hosting)
# DATABASE_URL holds personal data (users, payments, progress, chat).
# CONTENT_DATABASE_URL may point to a separate DB for curriculum + embeddings.
DATABASE_URL=postgresql://yenetta:yenetta@localhost:5432/yenetta
CONTENT_DATABASE_URL=postgresql://yenetta:yenetta@localhost:5432/yenetta
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_PER_HOUR=5

# Admin TOTP MFA. MFA_ENCRYPTION_KEY encrypts stored TOTP secrets at rest
# (leave blank in dev to derive from the JWT secrets); MFA_ISSUER labels the
# entry shown in the authenticator app.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Yenetta

# OpenAI (provider abstraction; swappable)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_STANDARD=gpt-4.1-mini
LLM_MODEL_HARD=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small

# SMS (mock in dev)
SMS_PROVIDER=mock           # mock | afromessage | twilio
SMS_API_KEY=

# Payments — Chapa (sandbox first)
PAYMENT_PROVIDER=chapa
CHAPA_MODE=sandbox          # sandbox | live
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Cost controls
FREE_TIER_DAILY_AI_LIMIT=20
PREMIUM_TIER_DAILY_AI_LIMIT=300
RETRIEVAL_TOP_K=6
MAX_OUTPUT_TOKENS=1200
